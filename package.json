{
  "name": "@rxtx4816/cockpit-plugin-base-react",
  "version": "0.0.0",
  "description": "Shared infrastructure for Cockpit plugins: i18n, dark theme, test setup, config presets, CI/CD workflows, and QEMU VM harness",
  "type": "module",
  "author": "RXTX4816",
  "license": "MIT",
  "homepage": "https://github.com/RXTX4816/cockpit-plugin-base-react",
  "repository": {
    "type": "git",
    "url": "https://github.com/RXTX4816/cockpit-plugin-base-react.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./dark-theme": {
      "default": "./src/dark-theme.ts"
    },
    "./log-tokens.css": "./src/log-tokens.css",
    "./i18n": {
      "default": "./src/i18n.ts"
    },
    "./bootstrap": {
      "default": "./src/bootstrap.tsx"
    },
    "./hooks/useAsyncAction": {
      "default": "./src/hooks/useAsyncAction.ts"
    },
    "./hooks/useAutoRefresh": {
      "default": "./src/hooks/useAutoRefresh.ts"
    },
    "./hooks/useAsyncStream": {
      "default": "./src/hooks/useAsyncStream.ts"
    },
    "./hooks/useConfirmAction": {
      "default": "./src/hooks/useConfirmAction.ts"
    },
    "./hooks/usePollingFetch": {
      "default": "./src/hooks/usePollingFetch.ts"
    },
    "./hooks/useAdminMode": {
      "default": "./src/hooks/useAdminMode.ts"
    },
    "./hooks/useKeyboardShortcuts": {
      "default": "./src/hooks/useKeyboardShortcuts.ts"
    },
    "./hooks/useOperationCounter": {
      "default": "./src/hooks/useOperationCounter.ts"
    },
    "./hooks/usePersistedSet": {
      "default": "./src/hooks/usePersistedSet.ts"
    },
    "./hooks/useDarkMode": {
      "default": "./src/hooks/useDarkMode.ts"
    },
    "./hooks/useLayout": {
      "default": "./src/hooks/useLayout.ts"
    },
    "./hooks/useLocalStorage": {
      "default": "./src/hooks/useLocalStorage.ts"
    },
    "./hooks/useSessionStorage": {
      "default": "./src/hooks/useSessionStorage.ts"
    },
    "./hooks/useDialogState": {
      "default": "./src/hooks/useDialogState.ts"
    },
    "./components": {
      "default": "./src/components/index.ts"
    },
    "./systemd": {
      "default": "./src/systemd/index.ts"
    },
    "./testing": {
      "default": "./src/testing/setup.ts"
    },
    "./testing/helpers": {
      "default": "./src/testing/helpers.ts"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint.config.base": {
      "default": "./eslint.config.base.js"
    },
    "./vitest.config.base": {
      "default": "./vitest.config.base.js"
    },
    "./lib/logParser": {
      "default": "./src/lib/logParser.tsx"
    },
    "./lib/ansi": {
      "default": "./src/lib/ansi.ts"
    },
    "./lib/bytes": {
      "default": "./src/lib/bytes.ts"
    },
    "./lib/parseJsonOutput": {
      "default": "./src/lib/parseJsonOutput.ts"
    },
    "./lib/timestamp": {
      "default": "./src/lib/timestamp.ts"
    },
    "./lib/color": {
      "default": "./src/lib/color.ts"
    },
    "./lib/tar": {
      "default": "./src/lib/tar.ts"
    },
    "./lib/envLint": {
      "default": "./src/lib/envLint.ts"
    },
    "./lib/uri": {
      "default": "./src/lib/uri.ts"
    },
    "./lib/cockpit-fs": {
      "default": "./src/lib/cockpit-fs.ts"
    },
    "./e2e": {
      "default": "./src/e2e/fixtures.js"
    },
    "./playwright.config.base": {
      "default": "./playwright.config.base.js"
    },
    "./esbuild.config.base": {
      "default": "./esbuild.config.base.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "docs/",
    "src/",
    "scripts/",
    "tsconfig.base.json",
    "eslint.config.base.js",
    "vitest.config.base.js",
    "playwright.config.base.js",
    "esbuild.config.base.js",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/__contract__/**",
    "!src/visual/**"
  ],
  "bin": {
    "cockpit-test-vm": "./scripts/test-vm.sh",
    "cockpit-i18n-check": "./scripts/i18n-coverage.mjs"
  },
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test --config playwright.config.visual.ts",
    "test:visual:update": "playwright test --config playwright.config.visual.ts --update-snapshots",
    "test:pack": "node scripts/run-pack-smoke.mjs",
    "yalc": "yalc push",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "peerDependencies": {
    "@codemirror/lint": ">=6",
    "@codemirror/merge": ">=6",
    "@codemirror/theme-one-dark": ">=6",
    "@eslint/js": "^9.39.4",
    "@patternfly/react-icons": ">=6",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "codemirror": ">=6",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": ">=26",
    "react": ">=19",
    "react-dom": ">=19",
    "react-i18next": ">=17"
  },
  "peerDependenciesMeta": {
    "@codemirror/lint": {
      "optional": true
    },
    "@codemirror/merge": {
      "optional": true
    },
    "@codemirror/theme-one-dark": {
      "optional": true
    },
    "@patternfly/react-icons": {
      "optional": true
    },
    "codemirror": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@eslint/js": "^9.39.4",
    "@patternfly/react-core": "^6.5.1",
    "@patternfly/react-icons": "^6.5.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "codemirror": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "^26.3.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "cockpit",
    "plugin",
    "base",
    "shared",
    "infrastructure"
  ]
}
